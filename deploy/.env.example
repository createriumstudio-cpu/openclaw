# LINE AI Partner – Environment Variables
# Copy to .env and fill in actual values

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Weather ---
OPENWEATHERMAP_API_KEY=

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notion ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- OAuth Callback ---
OAUTH_REDIRECT_URI=https://openclaw-line-ai-partner.fly.dev/oauth/callback

# --- Payment (Apple IAP / Carrier Billing / LINE Pay) ---
APP_STORE_CONNECT_KEY_ID=
CARRIER_BILLING_API_KEY=
LINE_PAY_CHANNEL_ID=

# --- App ---
NODE_ENV=production
PORT=3000
